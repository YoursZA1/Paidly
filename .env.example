# ===========================================
# Frontend environment variables (Vite)
# ===========================================
# Copy to .env and fill in, or use environment-specific files:
#   .env.development.example → .env.development   (DEV – npm run dev)
#   .env.production.example  → .env.production    (PROD – npm run build)
# Only variables prefixed with VITE_ are exposed to the client.
# Full setup: docs/SUPABASE_SETUP_AND_MAINTENANCE.md

# Backend API base URL (no trailing slash).
# Local:  http://localhost:5179  (port required — same as `npm run server`)
# Production (example): https://api.paidly.co.za
VITE_SERVER_URL=http://localhost:5179

# Production only: set to 1 if you deploy without the Node API (silences missing VITE_SERVER_URL warning on Vercel).
# VITE_SUPABASE_ONLY=1

# Supabase (REQUIRED for auth and storage)
# Use ANON (public) key only. Service role key must NEVER be exposed on frontend (server-only).
# DEV: use dev/staging project. PROD: set VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY correctly in production.
#
# IMPORTANT: BOTH variables are required. If VITE_SUPABASE_URL is missing, the client falls back to a
#   placeholder host and sign-in fails SILENTLY (no obvious UI error). Always set both together.
#   - VITE_SUPABASE_URL must be https://YOUR_REF.supabase.co  (.supabase.co, not .supabase.com)
#   - VITE_SUPABASE_ANON_KEY must be the JWT anon key (starts with "eyJ"), NOT an "sb_publishable_..." key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Storage bucket name (optional; default: paidly)
VITE_SUPABASE_STORAGE_BUCKET=paidly

# Cross-origin only: if login runs on a different origin than the dashboard, set the dashboard origin (e.g. https://www.paidly.co.za).
# Single deployment on www.paidly.co.za: leave VITE_APP_URL unset (same-origin after auth).
# Use the same VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY everywhere so all hosts share one database.
# Supabase Auth → Redirect URLs: https://www.paidly.co.za/** (and apex/legacy hosts if needed). See docs/AUTH_AND_LOGIN.md.
VITE_APP_URL=

# Error monitoring (Sentry) — optional but strongly recommended for production
# Get DSN from: https://sentry.io → Your project → Settings → Client Keys (DSN)
# Leave blank in local dev; set in your host's environment variables for production.
VITE_SENTRY_DSN=
# Set to true to send Sentry events in non-production environments (e.g. staging)
# VITE_SENTRY_FORCE_ENABLE=false
