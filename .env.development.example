# ===========================================
# DEVELOPMENT – Frontend environment (Vite)
# ===========================================
# Copy to .env.development or .env and fill in.
# Used when running: npm run dev (mode = development)
# Use a DEV or STAGING Supabase project only. Never use production here.
# See: docs/SUPABASE_SETUP_AND_MAINTENANCE.md

# Backend API (local dev server). MUST include port 5179 (npm run server). Do not use http://localhost: alone.
VITE_SERVER_URL=http://localhost:5179

# Supabase – DEV/STAGING project (anon key only; service role never on frontend)
# Dashboard → your dev/staging project → Settings → API → Project URL + anon public key
#
# IMPORTANT: BOTH are required and must be set together. A missing VITE_SUPABASE_URL makes the
#   client fall back to a placeholder host — sign-in then fails SILENTLY with no UI error.
#   - VITE_SUPABASE_URL  → https://YOUR_REF.supabase.co  (.supabase.co, not .supabase.com)
#   - VITE_SUPABASE_ANON_KEY → JWT anon key (starts with "eyJ"), NOT an "sb_publishable_..." key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Storage bucket (optional; default: paidly)
VITE_SUPABASE_STORAGE_BUCKET=paidly

# Local: route sign-in/sign-up through /api/auth/* (requires npm run server + Vite proxy)
VITE_NODE_AUTH_API=1
