# Server
# Supabase setup and maintenance: see ../docs/SUPABASE_SETUP_AND_MAINTENANCE.md
PORT=5179
CLIENT_ORIGIN=http://localhost:5173

# Payfast
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_NOTIFY_URL=http://localhost:5179/api/payfast/itn
PAYFAST_RETURN_URL=http://localhost:5173/AdminSubscriptions
PAYFAST_CANCEL_URL=http://localhost:5173/AdminSubscriptions

# Supabase (server-side only; NEVER put service role key in frontend / VITE_* vars)
SUPABASE_URL=
# Anon public key — same value as VITE_SUPABASE_ANON_KEY on the frontend.
# Required for POST /api/auth/sign-in, /api/auth/sign-up, etc.
SUPABASE_ANON_KEY=
# Service role key — bypasses RLS; required for admin operations (invite, purge, rate-limit RPC).
# Get from: Supabase Dashboard → Your project → Settings → API → service_role (secret)
# ⚠️  Never commit the real value. Never expose via VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_BOOTSTRAP_TOKEN=
SUPABASE_STORAGE_BUCKET=paidly
# Allow listed emails to access admin endpoints without app_metadata.role=admin (only when true)
ADMIN_BYPASS_AUTH=false
# Comma-separated emails; only used when ADMIN_BYPASS_AUTH=true
ADMIN_BYPASS_EMAILS=

# Resend (invoice email with PDF attachment)
# Get key from https://resend.com — you must verify your sending domain (e.g. billing@yourdomain.com); cannot send from @gmail.com
RESEND_API_KEY=
RESEND_FROM=Paidly <billing@yourdomain.com>

# Error monitoring (Sentry) — optional but strongly recommended for production
# Get DSN from: https://sentry.io → Your project → Settings → Client Keys (DSN)
SENTRY_DSN=

# Shared auth rate limits across Vercel instances (default on in production)
RATE_LIMIT_PERSIST=true

# Cloudflare Turnstile (bot protection on auth and public-submission routes)
# Get keys from: https://dash.cloudflare.com → Turnstile → your widget
# TURNSTILE_SECRET_KEY is server-only — never expose it in VITE_* variables.
# The public VITE_TURNSTILE_SITE_KEY goes in the frontend .env.production file.
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false
TURNSTILE_REQUIRE_SIGNIN=false
TURNSTILE_REQUIRE_SIGNUP=false
TURNSTILE_REQUIRE_FORGOT_PASSWORD=false
TURNSTILE_REQUIRE_WAITLIST=false

# POS integrations (Square OAuth + Yoco connect + generic webhooks)
# Full setup: docs/POS_INTEGRATIONS.md
# Encrypt stored OAuth tokens / Yoco API keys (32+ chars; server-only).
POS_CREDENTIALS_ENCRYPTION_KEY=

# Square OAuth (Settings → Integrations → Connect with Square)
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
# sandbox | production
SQUARE_ENVIRONMENT=sandbox
# Application personal access token — creates app-level webhook subscription (not per-seller OAuth token)
SQUARE_PERSONAL_ACCESS_TOKEN=
# From Square Developer Console → Webhooks → Signature key
SQUARE_WEBHOOK_SIGNATURE_KEY=
