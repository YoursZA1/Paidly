# ===========================================
# PRODUCTION – Frontend environment (Vite)
# ===========================================
# Copy to .env.production or set in your host’s env (Vercel, Netlify, etc.).
# Used when running: npm run build (mode = production)
#
# IMPORTANT: Use a dedicated PRODUCTION Supabase project. The values below are
# PLACEHOLDERS. Replace them with your real production URL and anon key before
# deploying. Never commit real keys to git; set them in your host’s environment.
# See: docs/SUPABASE_SETUP_AND_MAINTENANCE.md
#
# Vercel/Netlify: Project → Settings → Environment Variables. Add for Production
# (and Preview if needed), then redeploy. Add your app URL in Supabase →
# Authentication → URL Configuration (Site URL & Redirect URLs).

# Backend API (production URL – set in host env or here)
# For Vercel deployment: leave empty to use same-origin API routes
# Example Node API host (no trailing slash): https://api.paidly.co.za
VITE_SERVER_URL=

# Supabase – PRODUCTION project only (anon key only; service role NEVER on frontend)
# Get from: Supabase Dashboard → Your production project → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_production_anon_key_here

# Storage bucket (optional; default: paidly)
VITE_SUPABASE_STORAGE_BUCKET=paidly

# Error monitoring (Sentry) — strongly recommended for production
# Get DSN from: https://sentry.io → Your project → Settings → Client Keys (DSN)
VITE_SENTRY_DSN=

# Source map upload (CI/CD only — never commit these)
# Get auth token from: https://sentry.io → User Settings → Auth Tokens
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=paidly-frontend

# Auth: production uses same-origin /api/auth/* on www unless you opt out:
# VITE_DISABLE_NODE_AUTH_API=1
# Or Supabase-only (no Node auth): VITE_SUPABASE_ONLY=1

# Cloudflare Turnstile (bot protection — public site key goes here; secret key is SERVER-ONLY)
# Get keys from: https://dash.cloudflare.com → Turnstile → your widget
# VITE_TURNSTILE_SITE_KEY is the public key — safe to bundle in client JS.
# TURNSTILE_SECRET_KEY is server-only — set it in server/.env or Vercel env vars, NEVER here.
VITE_TURNSTILE_SITE_KEY=
VITE_TURNSTILE_REQUIRE_SIGNIN=true
VITE_TURNSTILE_REQUIRE_SIGNUP=true
VITE_TURNSTILE_REQUIRE_FORGOT_PASSWORD=true
VITE_TURNSTILE_REQUIRE_WAITLIST=true

# Vercel serverless (not VITE_*): SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
# RESEND_API_KEY, TURNSTILE_SECRET_KEY (if Turnstile enabled),
# POS_* / SQUARE_* (see docs/POS_INTEGRATIONS.md)
